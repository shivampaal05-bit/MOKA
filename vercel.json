{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(health|menu|board|orders|webhooks|dev|staff|kds|expo|tasks|stations|stream|inventory|ledger|admin)(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
