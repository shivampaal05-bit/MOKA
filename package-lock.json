{
  "name": "queuebite",
  "version": "4.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "queuebite",
      "version": "4.0.0",
      "workspaces": [
        "packages/*",
        "apps/*",
        "tools/*"
      ],
      "engines": {
        "node": ">=22.18"
      }
    },
    "apps/api": {
      "name": "@queuebite/api",
      "version": "4.0.0"
    },
    "node_modules/@queuebite/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@queuebite/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@queuebite/inventory": {
      "resolved": "packages/inventory",
      "link": true
    },
    "node_modules/@queuebite/scheduler": {
      "resolved": "packages/scheduler",
      "link": true
    },
    "node_modules/@queuebite/simulator": {
      "resolved": "tools/simulator",
      "link": true
    },
    "packages/domain": {
      "name": "@queuebite/domain",
      "version": "4.0.0"
    },
    "packages/inventory": {
      "name": "@queuebite/inventory",
      "version": "4.0.0"
    },
    "packages/scheduler": {
      "name": "@queuebite/scheduler",
      "version": "4.0.0"
    },
    "tools/simulator": {
      "name": "@queuebite/simulator",
      "version": "4.0.0"
    }
  }
}
